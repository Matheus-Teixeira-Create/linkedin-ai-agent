# Configurações locais da aplicação
# Valores aceitos: development, test, staging ou production.
APP_ENV=development
LOG_LEVEL=INFO

# Preencha somente após escolher um provedor autorizado e configurar o acesso.
AI_PROVIDER=
AI_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Configure localmente; nunca versione uma URL com credenciais reais.
DATABASE_URL=

# Gere 48 bytes com CSPRNG: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Armazene somente no ambiente do processo ou em um gerenciador de segredos.
JWT_SECRET_KEY=
JWT_ISSUER=linkedin-ai-agent
JWT_AUDIENCE=linkedin-ai-agent-client
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Em HTTP local use false; em produção configure explicitamente true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
